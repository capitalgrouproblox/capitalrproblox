<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Capital RP</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #080808;
    color: #fff;
}

/* NAVBAR */

header {
    position: fixed;
    top: 0;
    width: 100%;
    height: 75px;
    background: rgba(8, 8, 8, 0.92);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    z-index: 1000;
    border-bottom: 1px solid rgba(180, 0, 0, 0.35);
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo img {
    width: 45px;
    height: 45px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid #a00000;
}

.logo h1 {
    font-size: 21px;
    letter-spacing: 1px;
}

.logo span {
    color: #c40000;
}

nav {
    display: flex;
    gap: 28px;
}

nav a {
    color: #ddd;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
}

nav a:hover {
    color: #e00000;
}

/* HERO */

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 20px 80px;

    background:
        linear-gradient(
            rgba(0,0,0,0.72),
            rgba(8,0,0,0.94)
        ),
        url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSThyA936E9UhyQCc0Hdw5I1A59Jr3qXc1KUzOK21h4MXo-FmTLby7oI9cf&s=10");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 850px;
}

.hero-logo {
    width: 150px;
    height: 150px;
    object-fit: cover;
    border-radius: 25px;
    border: 2px solid #a80000;
    box-shadow: 0 0 45px rgba(190, 0, 0, 0.35);
    margin-bottom: 25px;
}

.hero h2 {
    font-size: clamp(45px, 8vw, 85px);
    font-weight: 900;
    letter-spacing: 4px;
}

.hero h2 span {
    color: #c40000;
}

.hero p {
    color: #bdbdbd;
    font-size: 18px;
    line-height: 1.7;
    max-width: 680px;
    margin: 20px auto;
}

/* BUTTONS */

.buttons {
    margin-top: 30px;
}

.btn {
    display: inline-block;
    padding: 14px 30px;
    margin: 6px;
    border-radius: 7px;
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
    transition: 0.3s;
}

.btn-red {
    background: #b00000;
    color: white;
    box-shadow: 0 0 20px rgba(190, 0, 0, 0.2);
}

.btn-red:hover {
    background: #d00000;
    transform: translateY(-3px);
}

.btn-dark {
    border: 1px solid #555;
    color: white;
    background: rgba(20,20,20,0.7);
}

.btn-dark:hover {
    border-color: #b00000;
    color: #e00000;
}

/* SECTION */

section {
    padding: 100px 8%;
}

.section-title {
    text-align: center;
    font-size: 38px;
    margin-bottom: 50px;
}

.section-title span {
    color: #c00000;
}

/* SOBRE */

.about {
    background: #0d0d0d;
    text-align: center;
    border-top: 1px solid #181818;
    border-bottom: 1px solid #181818;
}

.about p {
    max-width: 850px;
    margin: auto;
    color: #aaa;
    line-height: 1.8;
    font-size: 17px;
}

/* CARDS */

.cards {
    max-width: 1100px;
    margin: auto;

    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}

.card {
    background: linear-gradient(
        145deg,
        #151515,
        #0c0c0c
    );

    border: 1px solid #242424;
    border-radius: 12px;
    padding: 30px;

    text-align: center;

    transition: 0.3s;
}

.card:hover {
    transform: translateY(-6px);
    border-color: #8f0000;
    box-shadow: 0 10px 35px rgba(120,0,0,0.15);
}

.card .icon {
    font-size: 35px;
    margin-bottom: 18px;
}

.card h3 {
    margin-bottom: 12px;
    color: #ddd;
}

.card p {
    color: #999;
    line-height: 1.6;
    font-size: 14px;
}

/* STATUS */

.status {
    background: #090909;
}

.status-box {
    max-width: 850px;
    margin: auto;

    background: #111;
    border: 1px solid #252525;
    border-radius: 12px;

    padding: 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.status-info h3 {
    margin-bottom: 8px;
}

.status-info p {
    color: #888;
}

.online {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #4ade80;
    font-weight: bold;
}

.online-dot {
    width: 10px;
    height: 10px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 10px #22c55e;
}

/* CTA */

.cta {
    text-align: center;

    background:
        linear-gradient(
            rgba(70,0,0,0.45),
            rgba(0,0,0,0.95)
        );
}

.cta h2 {
    font-size: 42px;
    margin-bottom: 15px;
}

.cta p {
    color: #aaa;
    margin-bottom: 25px;
}

/* FOOTER */

footer {
    background: #050505;
    padding: 30px 8%;
    text-align: center;
    color: #666;
    font-size: 13px;
    border-top: 1px solid #1c1c1c;
}

footer strong {
    color: #a00000;
}

/* MOBILE */

@media (max-width: 700px) {

    header {
        padding: 0 20px;
    }

    nav {
        display: none;
    }

    .hero {
        padding-top: 110px;
    }

    .hero-logo {
        width: 120px;
        height: 120px;
    }

    .hero h2 {
        font-size: 43px;
        letter-spacing: 2px;
    }

    .hero p {
        font-size: 15px;
    }

    section {
        padding: 70px 20px;
    }

    .section-title {
        font-size: 30px;
    }

    .status-box {
        flex-direction: column;
        text-align: center;
    }
}
</style>
</head>

<body>

<header>

    <div class="logo">

        <img
        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSThyA936E9UhyQCc0Hdw5I1A59Jr3qXc1KUzOK21h4MXo-FmTLby7oI9cf&s=10"
        alt="Capital RP">

        <h1>CAPITAL <span>RP</span></h1>

    </div>

    <nav>
        <a href="#inicio">Início</a>
        <a href="#sobre">Sobre</a>
        <a href="#recursos">Recursos</a>
        <a href="#status">Status</a>
    </nav>

</header>


<!-- HERO -->

<section class="hero" id="inicio">

    <div class="hero-content">

        <img
        class="hero-logo"
        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSThyA936E9UhyQCc0Hdw5I1A59Jr3qXc1KUzOK21h4MXo-FmTLby7oI9cf&s=10"
        alt="Capital RP">

        <h2>
            CAPITAL <span>RP</span>
        </h2>

        <p>
            Uma nova experiência de Roleplay está chegando.
            Construa sua história, escolha seu caminho
            e faça parte da cidade.
        </p>

        <div class="buttons">

            <a href="#" class="btn btn-red">
                JOGAR AGORA
            </a>

            <a href="#" class="btn btn-dark">
                DISCORD
            </a>

        </div>

    </div>

</section>


<!-- SOBRE -->

<section class="about" id="sobre">

    <h2 class="section-title">
        SOBRE O <span>CAPITAL RP</span>
    </h2>

    <p>
        O Capital RP é um projeto desenvolvido para proporcionar
        uma experiência de Roleplay moderna e organizada dentro
        do Roblox. Nosso objetivo é criar uma cidade dinâmica,
        com sistemas próprios, organizações, empregos e uma
        comunidade ativa.
    </p>

</section>


<!-- RECURSOS -->

<section id="recursos">

    <h2 class="section-title">
        RECURSOS DO <span>PROJETO</span>
    </h2>

    <div class="cards">

        <div class="card">
            <div class="icon">🚔</div>
            <h3>Segurança Pública</h3>
            <p>
                Sistema de polícia e organizações
                responsáveis pela segurança da cidade.
            </p>
        </div>

        <div class="card">
            <div class="icon">🏥</div>
            <h3>Serviço Médico</h3>
            <p>
                Atendimento médico e sistema
                hospitalar para os cidadãos.
            </p>
        </div>

        <div class="card">
            <div class="icon">🚗</div>
            <h3>Veículos</h3>
            <p>
                Diversos veículos para utilização
                durante sua experiência na cidade.
            </p>
        </div>

        <div class="card">
            <div class="icon">💼</div>
            <h3>Empregos</h3>
            <p>
                Trabalhe, conquiste dinheiro e
                desenvolva sua história no servidor.
            </p>
        </div>

    </div>

</section>


<!-- STATUS -->

<section class="status" id="status">

    <div class="status-box">

        <div class="status-info">

            <h3>Capital RP</h3>

            <p>
                Status atual do projeto
            </p>

        </div>

        <div class="online">

            <div class="online-dot"></div>

            EM DESENVOLVIMENTO

        </div>

    </div>

</section>


<!-- CTA -->

<section class="cta">

    <h2>FAÇA PARTE DA CIDADE</h2>

    <p>
        Prepare-se para viver uma nova história.
    </p>

    <a href="#" class="btn btn-red">
        ENTRAR NO DISCORD
    </a>

</section>


<footer>

    © 2026 <strong>Capital RP</strong>.
    Todos os direitos reservados.

</footer>

</body>
</html>
